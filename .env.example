# === 必須 ===
SF_USERNAME=<your-salesforce-username>
SF_PASSWORD=<your-password>
SF_SECURITY_TOKEN=<your-security-token>
SF_DOMAIN=login
SF_BASE_URL=https://<your-org>.my.salesforce.com

MACRO_ROOT_PATH=Z:\Users\you\macros      # マクロ xlsm の root フォルダ（フルパス）
OUTPUT_ROOT_PATH=Z:\Users\you\outputs    # csv 出力先の root フォルダ（フルパス）
PIPELINES=devtest                      # pipeline 名（カンマ区切り）

# === optional: report_filter 用 ===
